# Пример переменных окружения. Скопируйте в backend/.env и при необходимости измените.

# --- Общие настройки ---
APP_NAME="Beeline RPS API"
DEBUG=false
LOG_LEVEL=INFO

# --- Хранение ---
# SQLite (по умолчанию):
DATABASE_URL="sqlite:///./beeline.db"
# PostgreSQL:
# DATABASE_URL="postgresql+psycopg://beeline:beeline@localhost:5432/beeline"

# --- Алгоритм ---
# Путь к каталогу с пакетом dispatch (обычно задавать не нужно).
# ALGORITHM_PATH=/app/routing_algorithm/beeline_optimizer_v2_final
SOLVER_SEED=42
SOLVER_TOTAL_SECONDS=20
SOLVER_WARM_START_SECONDS=5
SOLVER_PRE_MASTER_SECONDS=2
SOLVER_LEX_CG_SECONDS=9
SOLVER_FINAL_MIP_SECONDS=4
ALGORITHM_WARMUP=true

# --- Ограничения входных данных ---
MAX_ENGINEERS=50
MAX_REQUESTS=200

# --- Геоданные ---
# Дорожный коэффициент нужен только в резервном режиме (без OpenRouteService).
ROAD_FACTOR=1.28
# Демо-геокодер (хэш адреса) — только для локальной отладки. На стенде выключите.
ALLOW_DEMO_GEOCODING=false

# --- Геокодер (п. 15): yandex | nominatim | none ---
GEOCODER_PROVIDER=none
# Ключ «JavaScript API и HTTP Геокодер» Яндекс.Карт (обязателен для yandex).
YANDEX_GEOCODER_API_KEY=
GEOCODER_TIMEOUT_SECONDS=6
GEOCODER_BBOX="35.1,54.2~40.3,57.0"
GEOCODER_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"

# --- OpenRouteService (расстояния и время по дорожной сети) ---
# Если ключ не задан, используется резервная оценка по прямой.
ORS_API_KEY=
ORS_BASE_URL="https://api.openrouteservice.org"
ORS_TIMEOUT_SECONDS=30
ORS_CHUNK_SIZE=50
ORS_CACHE_SIZE=8

# --- CORS: список источников через запятую (или "*" для разработки) ---
CORS_ORIGINS="https://bee-dynasty.ru,https://bee-dynasty.ru:8443,https://bee-dynasty.ru:9443"

# --- Авторизация (JWT, роли) ---
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=21
# Обязательно смените на стенде (S2) и не публикуйте в описании Swagger.
DEMO_PASSWORD=change-me-on-stand
TIMEZONE=Europe/Moscow

# --- Стенд ---
# Массовые DELETE на публичном стенде должны быть выключены (S2).
ALLOW_DESTRUCTIVE=false
DEFAULT_REGION_ID=east

# Cooldown после 429 от OpenRouteService (сек): не долбим сервис, откат на прямые.
ORS_RATE_LIMIT_COOLDOWN_SECONDS=60

# Запасной бесплатный роутер геометрии (FOSSGIS OSRM) при недоступности ORS.
OSRM_GEOMETRY_FALLBACK=true
OSRM_BASE_URL="https://routing.openstreetmap.de"

# --- Локальный OSRM (car) — основной провайдер маршрутов/матриц ---
# Граф готовится скриптом osrm/init_osrm.sh, сервис поднимается docker compose.
OSRM_LOCAL_ENABLED=true
OSRM_LOCAL_URL="http://osrm:5000"
OSRM_LOCAL_TIMEOUT_SECONDS=15
OSRM_LOCAL_CACHE_SIZE=6
