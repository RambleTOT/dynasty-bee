# Секреты и настройки для `docker compose`. В git не коммитится (.env в .gitignore).
# Скопируйте: cp .env.example .env

# --- Стенд ---
ALLOW_DESTRUCTIVE=false
DEFAULT_REGION_ID=east

# --- Авторизация (обязательно сменить на публичном стенде) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=21
DEMO_PASSWORD=change-me-on-stand

# --- Провайдеры дорог (необязательно) ---
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_LOCAL_ENABLED=true
OSRM_LOCAL_URL=http://osrm:5000

# --- Геокодер (необязательно): yandex | nominatim | none ---
GEOCODER_PROVIDER=none
YANDEX_GEOCODER_API_KEY=
ALLOW_DEMO_GEOCODING=true

# --- CORS: домены сайта ---
CORS_ORIGINS=https://bee-dynasty.ru,https://bee-dynasty.ru:8443,https://bee-dynasty.ru:9443

# --- Прочее ---
TIMEZONE=Europe/Moscow
TZ=Europe/Moscow
