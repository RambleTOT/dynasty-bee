VITE_API_URL=/api/v1
VITE_USE_MOCKS=false
# включить флаги правок бэка без правки кода (FRONTEND_SPEC §5.4), через запятую:
VITE_FEATURES=
# ключ Яндекс Карт (JavaScript API и HTTP Геокодер), ограничить по HTTP Referer: встроенная карта с маршрутом
VITE_YANDEX_MAPS_KEY=
# подсказки адресов (Photon, OpenStreetMap): пусто — photon.komoot.io, off — выключить
VITE_ADDRESS_SUGGEST_URL=
# только для scripts/snapshot-api.mjs, реальные значения — в .env.local (не коммитить):
API_URL=https://api.bee-dynasty.ru/api/v1
DEMO_DISPATCHER=dispatcher
DEMO_OPERATOR=operator
DEMO_ENGINEER=eng-east-01
DEMO_PASSWORD=
